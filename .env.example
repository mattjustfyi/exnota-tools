APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# These need to match the URL used to access the website, otherwise requests
# won't work. This includes when using ngrok.
APP_URL=http://localhost
ASSET_URL=http://localhost
APP_SERVICE=laravel.local # Should match docker-compose. Used by Sail.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Other slack logging config in logging.php
LOG_SLACK_WEBHOOK_URL=null
LOG_SLACK_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis-cache
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WWWGROUP=1000
WWWUSER=1000

SAIL_XDEBUG_MODE=develop,debug,coverage

NOTION_CLIENT_ID=
NOTION_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://melodash.matt.fyi/spotify/redirect
SPOTIFY_ACCESS_TOKEN=

# I don't think it matters what the app ID or key are. I've been setting the
# app ID to 6 digit number and key/secret to randomly generated strings. Simply
# copied that pattern from tutorials. There seems to be no documentation on
# this.
REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret
# I think these these are credientials used to create the Reverb service and
# for other Laravel services to connect to it. Though that's just a guess. They
# DON'T seem to be credentials used to connect to the Reverb service from the
# frontend. Those are the VITE_ values below.
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# These values were not needed in local development without ngrok.
#
# With ngrok the host and port need to be changed, however  the app key and
# scheme also need to be provided for some reason. Not sure why if it works
# without them when not using ngrok.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Exclude scheme for host! I.e. no "https"
VITE_REVERB_HOST=localhost
# Port and scheme have working defaults in resources/js/echo.js for ngrok. I.e.
# port 80 for `ws`, port 443 for `wss` and scheme `https`.
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=http