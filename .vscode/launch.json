{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Sail Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "/var/www/html": "${workspaceFolder}"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "CSV Duplicate",
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/tools/csv-duplicate/index.js",
            "args": [
                "${workspaceFolder}/tools/csv-duplicate/data/${input:csvDuplicateCSV}"
            ]
        }
    ],
    "inputs": [
        {
            "id": "csvDuplicateCSV",
            "type": "promptString",
            "description": ""
        }
    ]
}
