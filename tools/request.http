### Save auth data (local)
# Note the content-type seems to be needed.
curl -X POST \
    -H "Content-Type: application/json" \
    -d '{"code": "hihi"}' \
    http://localhost/api/notion/auth/save

### Save auth data (prod)
# Note the content-type seems to be needed.
curl -X POST \
    -H "Content-Type: application/json" \
    -d '{"authData": {"key": "value"}}' \
    https://tools.exnota.com/api/notion/auth/save

### Refresh workspace (local)
curl -X POST \
    -H "Content-Type: application/json" \
    http://localhost/test/workspace/36/refresh

### Refresh workspace (prod)
curl -X POST \
    -H "Content-Type: application/json" \
    https://tools.exnota.com/test/workspace/1/refresh
