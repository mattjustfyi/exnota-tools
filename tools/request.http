### Save auth data (local)
# Note the content-type seems to be needed.
curl -X POST \
    -H "Content-Type: application/json" \
    -d '{"code": "hihi"}' \
    http://localhost/api/notion/auth/save

### Save auth data (prod)
# Note the content-type seems to be needed.
curl -X POST \
    -H "Content-Type: application/json" \
    -d '{"authData": {"key": "value"}}' \
    https://tools.exnota.com/api/notion/auth/save

### Refresh workspace (local)
curl -X POST \
    -H "Content-Type: application/json" \
    http://localhost/test/workspace/36/refresh

### Refresh workspace (prod)
curl -X POST \
    -H "Content-Type: application/json" \
    https://tools.exnota.com/test/workspace/1/refresh


### Slack webhook
# https://api.slack.com/apps/A07QLH0RKV5/incoming-webhooks
curl -X POST -H 'Content-type: application/json' --data '{"text":"Hello, World!"}' https://hooks.slack.com/services/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

### Find databases
curl -X POST 'https://api.notion.com/v1/search' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Content-Type: application/json' \
  -H 'Notion-Version: 2022-06-28' \
  --data '{
    "sort":{
      "direction":"ascending",
      "timestamp":"last_edited_time"
    },
    "filter":{
      "value":"database",
      "property":"object"
    }
  }'

### Clear multi select options
curl --location --request PATCH 'https://api.notion.com/v1/databases/146944fbb2bc811593e9c5c89dcfc054' \
--header 'Authorization: Bearer '"{{notionAccessToken}}"'' \
--header 'Content-Type: application/json' \
--header 'Notion-Version: 2022-06-28' \
--data '{
  "properties": {
    "Album Artists": {
      "name": "Album Artists",
      "type": "multi_select",
      "multi_select": {
        "options": []
      }
    }
  }
}'

### Fetch database
curl 'https://api.notion.com/v1/databases/144944fbb2bc81ce802dc4f6e25b8766' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Notion-Version: 2022-06-28'

### Query database
curl -X POST 'https://api.notion.com/v1/databases/144944fbb2bc81ce802dc4f6e25b8766/query' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Notion-Version: 2022-06-28' \
  -H "Content-Type: application/json" \
--data '{
    "filter": {
      "or": [
        {
          "property": "Music Stats Helper",
          "relation": {
            "is_empty": true
          }
        }
      ]
    },
    "sorts": [
        {
          "property": "Played At Timestamp",
          "direction": "ascending"
        }
    ]
  }'


### Query database
curl -X POST 'https://api.notion.com/v1/databases/144944fbb2bc81ce802dc4f6e25b8766/query' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Notion-Version: 2022-06-28' \
  -H "Content-Type: application/json" \
  --data '{
    "sorts": [
        {
          "property": "Played At Timestamp",
          "direction": "ascending"
        }
    ]
  }'

### Get bot
curl -X GET 'https://api.notion.com/v1/users/me' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Content-Type: application/json' \
  -H 'Notion-Version: 2022-06-28'

### Search any
curl -X POST 'https://api.notion.com/v1/search' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Content-Type: application/json' \
  -H 'Notion-Version: 2022-06-28' \
  --data '{
    "sort":{
      "direction":"ascending",
      "timestamp":"last_edited_time"
    }
  }'

